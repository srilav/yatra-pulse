{
  "description": "Itineraries with the result trip check must give. 'expect' lists statuses that must appear (as legs or notes) with a pattern their text must match; 'forbid' lists statuses that must not appear.",
  "cases": [
    { "name": "Two concerts at different venues at once", "mode": "car",
      "stops": [{ "key": "ev:17:Jasmine Sandlas closing night", "day": 17 }, { "key": "ev:17:Drone show", "day": 17 }],
      "expect": [{ "status": "bad", "match": "^Clash" }] },
    { "name": "Same venue in the evening", "mode": "car",
      "stops": [{ "key": "ev:21:Jamboo Savari", "day": 21 }, { "key": "nt:Palace illumination", "day": 21 }],
      "expect": [{ "status": "ok", "match": "Same venue" }], "forbid": ["bad"] },
    { "name": "Jamboo Savari to torchlight parade by car fits", "mode": "car",
      "stops": [{ "key": "ev:21:Jamboo Savari", "day": 21 }, { "key": "ev:21:Torchlight parade", "day": 21 }],
      "expect": [{ "status": "ok", "match": "km, about \\d+ min by car" }], "forbid": ["bad"] },
    { "name": "Same trip by bus is too slow", "mode": "bus",
      "stops": [{ "key": "ev:21:Jamboo Savari", "day": 21 }, { "key": "ev:21:Torchlight parade", "day": 21 }],
      "expect": [{ "status": "bad", "match": "^Not enough time" }] },
    { "name": "Jamboo Savari gate deadline is flagged", "mode": "car",
      "stops": [{ "key": "ev:21:Jamboo Savari", "day": 21 }],
      "expect": [{ "status": "warn", "match": "be inside by" }] },
    { "name": "Far day trip by auto-rickshaw", "mode": "auto",
      "stops": [{ "key": "trip:Shravanabelagola", "day": 19 }],
      "expect": [{ "status": "bad", "match": "too far for an auto-rickshaw" }] },
    { "name": "Same far trip by car is fine", "mode": "car",
      "stops": [{ "key": "trip:Shravanabelagola", "day": 19 }],
      "forbid": ["bad"] },
    { "name": "Unannounced time is flagged", "mode": "car",
      "stops": [{ "key": "ev:18:Surya Kiran air show", "day": 18 }],
      "expect": [{ "status": "warn", "match": "time not announced" }] },
    { "name": "Concert overlapping an all-evening show gets a leave-by warning", "mode": "car",
      "stops": [{ "key": "ev:15:Sid Sriram live", "day": 15 }, { "key": "nt:Classical music & dance", "day": 15 }],
      "expect": [{ "status": "warn", "match": "Leave by" }], "forbid": ["bad"] },
    { "name": "Morning day trip then evening concert", "mode": "car",
      "stops": [{ "key": "trip:Srirangapatna", "day": 13, "time": "08:00" }, { "key": "ev:13:Yuva Dasara opening night", "day": 13 }],
      "expect": [{ "status": "ok", "match": "You have \\d+ min" }], "forbid": ["bad"] }
  ]
}
